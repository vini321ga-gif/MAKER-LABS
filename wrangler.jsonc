{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maker-labs",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maker-labs-db",
      "database_id": "c1a87869-57ce-441c-aab6-af189fb1e615",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "maker-labs-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
