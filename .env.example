# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
SESSION_SECRET="dev-precisionhub-session-secret-change-in-prod"

# Optional Cloudflare D1 Remote Database Configuration
# When all three variables are set, queries execute against Cloudflare D1 REST API.
# When omitted, the server runs seamlessly against local SQLite (data/workshop.db) using identical D1 SQL.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""
